# Copy to ~/.config/timetable-watcher/myclass.env (chmod 600)
# Obtain the code from the timetable website's ?sc= parameter.
TIMETABLE_SCHOOL_CODE=replace-school-code
TIMETABLE_SCHOOL_NAME=replace-school-name
TIMETABLE_GRADE=1
TIMETABLE_CLASSROOM=1
GOOGLE_CHAT_WEBHOOK_URL='replace-google-chat-webhook-url'
